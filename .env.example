# ───────── Banco (Postgres; na Vercel use o Neon) ─────────
# Dono das tabelas: roda as migrations e as operações antes do login.
DATABASE_URL=postgres://USUARIO:SENHA@HOST/kfit?sslmode=require
# Papel kfit_app (criado pela migration, SEM bypass da trava). Use a URL com pool do Neon.
DATABASE_APP_URL=postgres://kfit_app:SENHA_DO_KFIT_APP@HOST/kfit?sslmode=require
# Só para o pnpm db:migrate: define a senha do papel kfit_app.
KFIT_APP_PASSWORD=

# ───────── Segurança ─────────
# 32+ caracteres aleatórios (ex.: openssl rand -hex 32). Trocar desconecta todo mundo.
SESSION_SECRET=
# Protege a rotina diária (/api/cron/diario). A Vercel envia sozinha.
CRON_SECRET=

# ───────── WhatsApp (Evolution API) — códigos de acesso e avisos ─────────
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Só em desenvolvimento: mostra o código na tela para qualquer studio. NUNCA em produção.
OTP_DEBUG=false

# ───────── Assistente com IA ─────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=60

# ───────── Monitor de erros (Sentry) ─────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
